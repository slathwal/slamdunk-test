// ===================================================================
//  slamdunk-nf : Nextflow wrapper for the slamdunk SLAM-seq analysis tool
// ===================================================================

params {
    // Input / reference
    input           = null          // samplesheet CSV: sample,fastq
    fasta           = null          // reference FASTA
    bed             = null          // 3'UTR BED file
    outdir          = 'results'

    // slamdunk 'all' parameters (defaults mirror the slamdunk CLI)
    trim_5p         = 12            // -5   bp trimmed from 5' end
    min_base_qual   = 27            // -mbq min base quality for T>C
    max_read_length = null          // -rl  max read length (null = auto)

    // Max resource ceilings
    max_cpus        = 16
    max_memory      = '64.GB'
    max_time        = '24.h'
}

// Publish outputs
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
        mode: 'copy',
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
    }
    withLabel: process_high {
        cpus   = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { "${8 * task.attempt}.GB" }
        time   = '8.h'
    }
    withName: SLAMDUNK_ALL {
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    wave {
        wave.enabled = true
        wave.strategy = 'container'
    }
    test {
        // projectDir resolves to the repository root (main.nf lives at the root)
        params.input           = "${projectDir}/assets/samplesheet_test.csv"
        params.fasta           = "${projectDir}/slamdunk/test/data/ref.fa"
        params.bed             = "${projectDir}/slamdunk/test/data/actb.bed"
        params.max_read_length = 100
        params.min_base_qual   = 27
        params.trim_5p         = 0
    }
}

manifest {
    name            = 'slamdunk-nf'
    description     = 'Nextflow pipeline wrapping the slamdunk SLAM-seq analysis tool'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}
